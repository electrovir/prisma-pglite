{
    "name": "prisma-pglite",
    "version": "3.0.1",
    "description": "Making Prisma easy to use with PGlite.",
    "keywords": [
        "prisma",
        "postgres",
        "pglite",
        "adapter",
        "migration",
        "database",
        "orm"
    ],
    "homepage": "https://github.com/electrovir/prisma-pglite",
    "bugs": {
        "url": "https://github.com/electrovir/prisma-pglite/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/prisma-pglite.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "npm run init && virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "init": "npx tsx src/util/setup-prisma.mock.script.ts",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node --test-concurrency=1",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "virmator test node coverage --test-concurrency=1",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "overrides": {
        "@hono/node-server": ">=1.19.13",
        "esbuild": "^0.28.1",
        "uuid": ">=11.1.1"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/node": "^32.2.1",
        "@augment-vir/test": "^32.2.1",
        "@prisma/schema-engine-wasm": "7.10.0-2.d0368e25c88e68caa4d283b5f2d88d1b76ed9356",
        "date-vir": "^8.6.2",
        "minimist": "^1.2.8",
        "postgres-array": "^3.0.4",
        "tsx": "^4.23.1",
        "url-vir": "^2.1.10"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.4",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@prisma/client": "^7.9.0",
        "@prisma/config": "^7.9.0",
        "@prisma/driver-adapter-utils": "^7.9.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "c8": "^12.0.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^22.2.9",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "prisma": "^7.9.0",
        "prisma-vir": "^4.0.1",
        "runstorm": "^1.0.6",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.2"
    },
    "peerDependencies": {
        "@electric-sql/pglite": "*",
        "@prisma/config": ">=7",
        "@prisma/driver-adapter-utils": "*",
        "prisma": ">=7"
    },
    "engines": {
        "node": ">=22"
    }
}
